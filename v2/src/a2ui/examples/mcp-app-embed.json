{
  "_description": "MCP Apps escape hatch inside an A2UI surface. The header and caption are native Aurora Chat components; the embedded viewer is a bundled Aurora MCP App that echoes the toolInput it receives. Proves the full AppBridge handshake + theme bridge + tool-input push path inline in chat. Real third-party MCP servers (get-time, qr-server, threejs-server) are tested separately in Phase 5 Tasks 14-16.",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "mcp_app_smoke",
        "catalogId": "aurora-chat://catalog/v0.1.json"
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "mcp_app_smoke",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "title": "MCP App smoke test",
            "subtitle": "Bundled tool-input-echo demo",
            "variant": "outlined",
            "child": "body_col"
          },
          {
            "id": "body_col",
            "component": "Column",
            "gap": 12,
            "children": ["desc_text", "viewer", "actions_row"]
          },
          {
            "id": "desc_text",
            "component": "Text",
            "variant": "caption",
            "text": "Loaded from the bundled aurora-bundled pseudo-server. The iframe runs in a sandbox with deny-by-default CSP; the AppBridge pushes our toolInput via ui/notifications/tool-input and the demo pretty-prints it."
          },
          {
            "id": "viewer",
            "component": "McpApp",
            "resourceUri": "ui://aurora-bundled/tool-input-echo.html",
            "server": "aurora-bundled",
            "height": 400,
            "toolInput": {
              "demo": "mcp-app-embed example",
              "modelUrl": "https://example.com/models/engine.glb",
              "renderer": "preview"
            }
          },
          {
            "id": "actions_row",
            "component": "Row",
            "gap": 8,
            "justify": "end",
            "children": ["reset_btn", "export_btn"]
          },
          {
            "id": "reset_btn",
            "component": "Button",
            "text": "Reset view",
            "variant": "ghost",
            "action": { "event": { "name": "resetViewer" } }
          },
          {
            "id": "export_btn",
            "component": "Button",
            "text": "Export PNG",
            "variant": "primary",
            "action": { "event": { "name": "exportViewer", "context": { "format": "png" } } }
          }
        ]
      }
    }
  ]
}
